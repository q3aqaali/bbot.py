@bot.message_handler(commands=["start"])
def start(message):

    if message.chat.type != "private":
        return

    user = message.from_user

    # إعادة ضبط أي عملية غير مكتملة
    user_data.pop(user.id, None)
    support_mode.discard(user.id)

    if user.id == ADMIN_ID:
        admin_state.pop(ADMIN_ID, None)

    # إشعار الأدمن بالمستخدم الجديد (مرة واحدة فقط)
    if register_user(user) and user.id != ADMIN_ID:
        try:
            notify_new_user(user)
        except Exception as e:
            print(f"[new user notify] {e}")

    if not ensure_subscribed(user.id):
        return

    send_welcome(message.chat.id, user)


