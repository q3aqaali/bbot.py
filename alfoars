def esc(value):
    return html.escape(str(value), quote=False)


def user_full_name(user):
    name = user.first_name or ""
    if user.last_name:
        name += " " + user.last_name
    return name.strip() or "بدون اسم"


def user_link(user_id, name):
    return f'<a href="tg://user?id={user_id}">{esc(name)}</a>'


def clean(text, limit=60):
    return " ".join(text.split())[:limit]


def parse_number(text):
    value = text.strip().translate(AR_DIGITS)
    if re.fullmatch(r"[0-9]{1,6}", value):
        return value
    return None


def get_setting(key):
    row = q_one("SELECT value FROM settings WHERE key = ?", (key,))
    return row["value"] if row else None


def set_setting(key, value):
    q_exec(
        "INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)",
        (key, value)
    )


def has_pending_application(user_id):
    return q_one(
        "SELECT id FROM applications WHERE user_id = ? AND status = 'pending'",
        (user_id,)
    ) is not None


def has_any_application(user_id):
    return q_one(
        "SELECT id FROM applications WHERE user_id = ? LIMIT 1",
        (user_id,)
    ) is not None


def register_user(user):
    """يرجع True إذا كان المستخدم جديداً."""
    cur = q_exec(
        "INSERT OR IGNORE INTO fw_users (user_id, first_name, username) VALUES (?, ?, ?)",
        (user.id, user_full_name(user), user.username)
    )
    return cur.rowcount == 1


