# =========================================================
# إجابات التقديم
# =========================================================


def handle_application_message(message):

    user_id = message.from_user.id
    data = user_data[user_id]
    step = data["step"]

    if message.content_type != "text":
        bot.send_message(user_id, "⚠️ أرسل إجابتك كنص فقط.")
        return

    text = message.text.strip()

    if step == 5:
        bot.send_message(
            user_id,
            "⚠️ اختر إجابتك من الأزرار الظاهرة في الرسالة السابقة."
        )
        return

    if not text:
        bot.send_message(user_id, "⚠️ أرسل إجابة صحيحة.")
        return

    # -----------------------------------------------------
    # 1 - الاسم
    # -----------------------------------------------------
    if step == 1:
        data["full_name"] = clean(text)
        data["step"] = 2

        bot.send_message(
            user_id,
            """
<b>السؤال 2 من 5:</b>

ما لقبك المشهور به؟

أرسل لقبك الآن.
"""
        )
        return

    # -----------------------------------------------------
    # 2 - اللقب
    # -----------------------------------------------------
    if step == 2:
        data["nickname"] = clean(text)
        data["step"] = 3

        bot.send_message(
            user_id,
            """
<b>السؤال 3 من 5:</b>

متى انضممت إلى الباند؟

⚠️ يجب إرسال رقم فقط.
"""
        )
        return

    # -----------------------------------------------------
    # 3 - تاريخ الانضمام للباند (رقم)
    # -----------------------------------------------------
    if step == 3:
        number = parse_number(text)

        if number is None:
            bot.send_message(
                user_id,
                "❌ إجابة غير صحيحة.\n\nيجب أن ترسل <b>رقماً فقط</b>، "
                "حاول مرة أخرى."
            )
            return

        data["band_join"] = number
        data["step"] = 4

        bot.send_message(
            user_id,
            """
<b>السؤال 4 من 5:</b>

ما عمرك؟

⚠️ يجب إرسال رقم فقط.
"""
        )
        return

    # -----------------------------------------------------
    # 4 - العمر (رقم)
    # -----------------------------------------------------
    if step == 4:
        number = parse_number(text)

        if number is None:
            bot.send_message(
                user_id,
                "❌ إجابة غير صحيحة.\n\nيجب أن ترسل <b>رقماً فقط</b>، "
                "حاول مرة أخرى."
            )
            return

        if not 1 <= int(number) <= 120:
            bot.send_message(
                user_id,
                "❌ العمر غير منطقي، أرسل عمرك الحقيقي."
            )
            return

        data["age"] = number
        data["step"] = 5

        markup = types.InlineKeyboardMarkup(row_width=2)
        markup.add(
            types.InlineKeyboardButton(
                "متعلم",
                callback_data="learned_yes",
                style="success"
            ),
            types.InlineKeyboardButton(
                "غير متعلم",
                callback_data="learned_no",
                style="danger"
            )
        )

        bot.send_message(
            user_id,
            """
<b>السؤال 5 من 5:</b>

هل انت متعلم او جديد؟
""",
            reply_markup=markup
        )


@bot.callback_query_handler(
    func=lambda call: call.data in ("learned_yes", "learned_no")
)
def learned_answer(call):

    user = call.from_user
    data = user_data.get(user.id)

    if not data or data.get("step") != 5:
        bot.answer_callback_query(
            call.id,
            "انتهت جلسة التقديم، أرسل /start وابدأ من جديد.",
            show_alert=True
        )
        return

    if has_pending_application(user.id):
        bot.answer_callback_query(
            call.id,
            "لديك طلب قيد المراجعة بالفعل.",
            show_alert=True
        )
        return

    user_data.pop(user.id, None)

    data["is_learned"] = "متعلم" if call.data == "learned_yes" else "غير متعلم"

    bot.answer_callback_query(call.id)
    remove_markup(call)

    finalize_application(user, data)


