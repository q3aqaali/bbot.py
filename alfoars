def handle_admin_message(message):
    """يرجع True إذا تمت معالجة الرسالة."""

    state = admin_state.get(ADMIN_ID)

    if state:

        action = state["action"]

        # ---------------- رد على مستخدم ----------------
        if action == "reply":
            admin_state.pop(ADMIN_ID, None)
            send_admin_reply(message, state["user_id"])
            return True

        if message.content_type != "text":
            bot.send_message(ADMIN_ID, "⚠️ أرسل نصاً فقط.")
            return True

        text = message.text.strip()

        # ---------------- رابط المجموعة ----------------
        if action == "set_group":

            if not (
                text.startswith("https://t.me/")
                or text.startswith("http://t.me/")
                or text.startswith("https://telegram.me/")
            ):
                bot.send_message(
                    ADMIN_ID,
                    """
❌ الرابط غير صحيح.

أرسل رابط تيليجرام صحيح يبدأ بـ:

<code>https://t.me/</code>
"""
                )
                return True

            set_setting("group_link", text)
            admin_state.pop(ADMIN_ID, None)

            bot.send_message(
                ADMIN_ID,
                f"""
<b>✅ تم حفظ رابط المجموعة بنجاح.</b>

━━━━━━━━━━━━━━━━━━

<b>الرابط الحالي:</b>

{esc(text)}

━━━━━━━━━━━━━━━━━━
"""
            )
            return True

        # ---------------- إضافة قناة ----------------
        if action == "add_channel":

            ref = parse_chat_ref(text)

            if ref is None:
                bot.send_message(
                    ADMIN_ID,
                    "❌ المدخل غير صحيح.\n\nأرسل يوزر القناة "
                    "(@name) أو رابطها العام أو الآيدي الخاص بها."
                )
                return True

            try:
                chat = bot.get_chat(ref)
                me = bot.get_me()
                member = bot.get_chat_member(chat.id, me.id)
            except Exception as e:
                bot.send_message(
                    ADMIN_ID,
                    f"❌ تعذر الوصول إلى القناة.\n\n"
                    f"تأكد أن البوت مضاف فيها.\n\n"
                    f"<code>{esc(e)}</code>"
                )
                return True

            if member.status not in ("administrator", "creator"):
                bot.send_message(
                    ADMIN_ID,
                    "❌ البوت ليس أدمن في هذه القناة.\n\n"
                    "ارفع البوت أدمن ثم أعد المحاولة."
                )
                return True

            title = chat.title or str(chat.id)
            link = None

            if chat.username:
                link = f"https://t.me/{chat.username}"
            else:
                try:
                    link = bot.export_chat_invite_link(chat.id)
                except Exception:
                    link = None

            if link:
                save_channel(chat.id, title, link)
                admin_state.pop(ADMIN_ID, None)
                bot.send_message(
                    ADMIN_ID,
                    f"✅ تمت إضافة <b>{esc(title)}</b> "
                    f"إلى الاشتراك الإجباري."
                )
                send_force_sub_menu()
                return True

            admin_state[ADMIN_ID] = {
                "action": "add_channel_link",
                "chat_id": chat.id,
                "title": title
            }

            bot.send_message(
                ADMIN_ID,
                "🔗 هذه القناة خاصة، أرسل الآن رابط الدعوة الخاص بها "
                "(يبدأ بـ <code>https://t.me/</code>)."
            )
            return True

        # ---------------- رابط دعوة قناة خاصة ----------------
        if action == "add_channel_link":

            if not text.startswith("https://t.me/"):
                bot.send_message(
                    ADMIN_ID,
                    "❌ الرابط غير صحيح، يجب أن يبدأ بـ "
                    "<code>https://t.me/</code>"
                )
                return True

            save_channel(state["chat_id"], state["title"], text)
            admin_state.pop(ADMIN_ID, None)

            bot.send_message(
                ADMIN_ID,
                f"✅ تمت إضافة <b>{esc(state['title'])}</b> "
                f"إلى الاشتراك الإجباري."
            )
            send_force_sub_menu()
            return True

        return True

    # ---------------- رد الأدمن بالـ Reply ----------------
    if message.reply_to_message:
        target_id = get_support_user(message.reply_to_message.message_id)

        if target_id:
            send_admin_reply(message, target_id)
            return True

    return False


