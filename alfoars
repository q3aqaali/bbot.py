def parse_chat_ref(raw):

    raw = raw.strip()

    match = re.fullmatch(
        r"(?:https?://)?(?:t\.me|telegram\.me)/([A-Za-z0-9_]{4,})/?",
        raw
    )

    if match:
        return "@" + match.group(1)

    if re.fullmatch(r"@[A-Za-z0-9_]{4,}", raw):
        return raw

    if re.fullmatch(r"-?[0-9]+", raw):
        return int(raw)

    return None


