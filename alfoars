def get_force_channels():
    return q_all("SELECT chat_id, title, link FROM fw_force_channels")


def get_unjoined(user_id):
    missing = []

    for channel in get_force_channels():
        try:
            member = bot.get_chat_member(channel["chat_id"], user_id)

            if member.status in ("left", "kicked"):
                missing.append(channel)
            elif (
                member.status == "restricted"
                and getattr(member, "is_member", True) is False
            ):
                missing.append(channel)

        except Exception as e:
            # تعذر التحقق (مثلاً البوت ليس أدمن) — لا نمنع المستخدم
            print(f"[force sub] {channel['chat_id']}: {e}")

    return missing


