def relay(message, target_id, header, markup=None):
    """
    يحوّل رسالة إلى target_id بالشكل:
    header + الرسالة: ...
    ويرجع قائمة بآيديات الرسائل المرسلة.
    """
    sent_ids = []

    if message.content_type == "text" and len(message.text) <= 3500:
        sent = bot.send_message(
            target_id,
            f"{header}\n\n<b>الرسالة:</b>\n{esc(message.text)}",
            reply_markup=markup
        )
        sent_ids.append(sent.message_id)

    else:
        sent = bot.send_message(
            target_id,
            f"{header}\n\n<b>الرسالة:</b> ⬇️",
            reply_markup=markup
        )
        sent_ids.append(sent.message_id)

        copied = bot.copy_message(
            target_id,
            message.chat.id,
            message.message_id
        )
        sent_ids.append(copied.message_id)

    return sent_ids


