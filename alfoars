db = sqlite3.connect("fawaris_team.db", check_same_thread=False)
db.row_factory = sqlite3.Row
db_lock = threading.RLock()


def q_all(query, params=()):
    with db_lock:
        return db.execute(query, params).fetchall()


def q_one(query, params=()):
    with db_lock:
        return db.execute(query, params).fetchone()


def q_exec(query, params=()):
    with db_lock:
        cur = db.execute(query, params)
        db.commit()
        return cur


def add_column_if_missing(table, column, definition):
    columns = [row["name"] for row in q_all(f"PRAGMA table_info({table})")]
    if column not in columns:
        q_exec(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")


